          "name": "POST - Sign Up (Positive)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const randomSuffix = Math.random().toString(36).substring(2, 8);\r\nconst uniqueUser = `user_${randomSuffix}`;\r\n\r\npm.environment.set(\"signup_username\", uniqueUser);\r\npm.environment.set(\"signup_password\", \"Test@1234\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Validate Status Code (Essential for resource creation)\r\npm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\n// 2. Validate Success Message\r\npm.test(\"Success message is correct\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.message).to.eql(\"User registered successfully.\");\r\n});\r\n\r\n// 3. Performance Check: Response time should be under 300ms\r\npm.test(\"Response time is less than 300ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(300);\r\n});\r\n\r\n// 4. Content-Type Check: Ensure it's JSON\r\npm.test(\"Content-Type is application/json\", function () {\r\n    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\r\n});\r\n\r\n// 5. Security Check: Password should NEVER be returned in response body\r\npm.test(\"Security Check: Password is not leaked in response\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.not.have.property('password');\r\n});"
                ]
              }
            }
          ],
